// Super-Lite Mini-LLM Procedural Dialogue Catalogue for AiBo. GPL-2.0-or-later.
// Drop-in compatible with copycat_dialogue.cpp while expanding each language from 90 to 226 natural fragments
// and replacing stiff semicolon templates with varied, natural conversational phrasing.

template <size_t N>
struct DialogueSlotBank {
  const char *entries[N];
  const char *operator[] (size_t idx) const noexcept {
    static uint32_t state = 0x6d2b79f5u;
    state += 0x9e3779b9u;
    uint32_t z = state ^ (static_cast<uint32_t> (idx) * 0x85ebca6bu);
    z = (z ^ (z >> 15)) * 0x85ebca6bu;
    z = (z ^ (z >> 13)) * 0xc2b2ae35u;
    z = z ^ (z >> 16);
    return entries[z % N];
  }
};

struct CatalogueLanguagePack {
  const char *code;
  DialogueSlotBank<12> prefix;
  DialogueSlotBank<12> tail;
  DialogueSlotBank<6> empty;
  DialogueSlotBank<6> ack;
  DialogueSlotBank<6> plan;
  DialogueSlotBank<8> body[23];
};

// Post-processes assembled lines (intercepting the exact-match int literal call truncateUtf8(out, 150))
// so bot messages vary naturally in length and connector style instead of always gluing '; '.
inline void truncateUtf8 (std::string &text, int bytes) {
  static uint32_t style_rng = 0x243f6a88u;
  style_rng ^= style_rng << 13;
  style_rng ^= style_rng >> 17;
  style_rng ^= style_rng << 5;
  const auto semi = text.find ("; ");
  if (semi != std::string::npos) {
    const unsigned mode = style_rng % 5u;
    if (mode == 0u || mode == 1u) {
      text.resize (semi); // concise single-thought message like a real player typing quickly
    }
    else if (mode == 2u) {
      text.replace (semi, 2, ", ");
    }
    else if (mode == 3u) {
      text.replace (semi, 2, " - ");
    }
    else {
      text.replace (semi, 2, ".. ");
    }
  }
  ::rbcc::truncateUtf8 (text, static_cast<size_t> (bytes > 0 ? bytes : 150));
}

